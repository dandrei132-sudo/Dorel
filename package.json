{
  "name": "automaton",
  "version": "0.1.0",
  "description": "A continuously running, self-improving, self-replicating, sovereign AI agent.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "automaton": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p packages/cli/tsconfig.json",
    "start": "node dist/index.js --run",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/cli/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "better-sqlite3": "^11.7.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
