# Required to run the real agent loop (Think -> Act -> Observe).
ANTHROPIC_API_KEY=

# Base Sepolia (testnet) JSON-RPC endpoint. Defaults to the public endpoint
# below if unset. Never point this at mainnet.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Password used to encrypt/decrypt the agent's local wallet keystore
# (~/.automaton/wallet.json). Set this in production instead of relying on
# the interactive setup-wizard prompt.
AUTOMATON_WALLET_PASSWORD=

# Optional: address of a deployed ERC-8004 identity registry contract on
# Base Sepolia. If unset, on-chain registration is skipped (logged, not
# guessed) rather than firing at a fabricated address.
ERC8004_REGISTRY_ADDRESS=

# Optional: override where runtime state (~/.automaton) lives.
AUTOMATON_HOME=

# Optional: point the Conway client at a real backend once one exists.
# Unset (default) uses the local mock ConwayClient so the agent loop runs
# standalone with a simulated credit ledger.
CONWAY_API_URL=

# Web control panel (browser/phone dashboard, started automatically by
# `--run`). If unset, a random password is generated on first run, printed
# once to the console, and its hash persisted to
# ~/.automaton/web-auth.json. Set your own here to skip that.
WEB_UI_PASSWORD=

# Defaults shown. WEB_UI_HOST defaults to loopback-only on purpose — see
# the "Web control panel" section of README.md before changing it.
WEB_UI_PORT=4173
WEB_UI_HOST=127.0.0.1
